# Server-side Salesforce OAuth configuration. Never put these values in frontend code.
SALESFORCE_CLIENT_ID=your_connected_app_consumer_key
SALESFORCE_CLIENT_SECRET=your_connected_app_consumer_secret
# Production: https://login.salesforce.com; sandbox: https://test.salesforce.com
# A My Domain origin can be used when the org requires it.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_REDIRECT_URI=https://localhost:8012/auth/salesforce/callback
SALESFORCE_OAUTH_SCOPES=api id
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SALESFORCE_SESSION_ENCRYPTION_KEY=replace_with_fernet_key
COOKIE_SECURE=true
FRONTEND_URL=https://localhost:8012
SALESFORCE_ALLOW_WRITEBACK=false

# Existing optional AI configuration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ENABLE_OPENAI_TRIAGE=false
